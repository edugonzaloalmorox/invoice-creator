# Copy this file to .env and replace the credential path with the local path to
# the secret-mounted Google service-account JSON file.
GOOGLE_CREDENTIALS_REFERENCE=/absolute/path/to/google-service-account.json

# The remaining values are optional for local development; Makefile defaults apply.
# INVOICE_ENVIRONMENT=development
# INVOICE_FRONTEND_ORIGIN=http://127.0.0.1:3000
# GOOGLE_TEMPLATE_ID=fixture-template
# INVOICE_MAX_REQUEST_BYTES=1048576
# INVOICE_MAX_RESPONSE_BYTES=5242880
# GOOGLE_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
# GOOGLE_PROVIDER_READ_TIMEOUT_SECONDS=10
